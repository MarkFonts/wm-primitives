{
  "name": "@markfonts/wm-primitives",
  "version": "0.0.1",
  "description": "Shared cross-app UI primitives for WORDMARK's font tools (font-proofer, ReCal Sans). Consumed as a git submodule; each app's Vite/tsc compiles the source directly.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@use-gesture/react": ">=10",
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "UNLICENSED",
  "private": false,
  "scripts": {
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "serve": "node tests/serve.mjs",
    "test:render": "playwright test tests/render",
    "test:render:update": "playwright test tests/render --update-snapshots",
    "test:behaviour": "playwright test tests/behaviour",
    "test": "playwright test",
    "build:dial": "node scripts/build-dial.mjs",
    "gen:index": "node scripts/gen-index.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
